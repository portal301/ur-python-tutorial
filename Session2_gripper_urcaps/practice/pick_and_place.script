  end 
  if(parameter_error):
  halt
  end 
  rg2ft_ProxL_offset=floor(ProxL+0.5)
  rg2ft_ProxR_offset=floor(ProxR+0.5)
  retVal=on_xmlrpc.rg2ft_proxi_offsets(rg2ft_ProxL_offset,rg2ft_ProxR_offset)
  if retVal!=0:
  popup(rg2ft_proxi_offsets_error,title=rg2ft_proxi_title,error=True,blocking=False)
  end
  if ON_DEBUG_LOG:
  textmsg("RG2-FT Proximity Offsets command stopping..")
  end 
