  def ft_search_relativeZ(tool_index,searchDistZ,speed=0.03,forceZ=5.0,popupmsg=True):
  on_tcp_set_actual_to(tool_index!=ON_DI_SECONDARY)
  ft_select=ON_FALSE8D
  ft_select[2]=True
  ft_limits=ON_ZERO8D
  ft_limits[2]=forceZ
  ft_abs=ON_FALSE6D
  frameID=1
  frameRPY=ON_ZERO3D
  searchUntil=ON_ZEROPOSE
  searchUntil[2]=searchDistZ
  isSearchReturn=True
  local retVal=ft_trajectory_move_relative_limited(searchUntil,ft_select,ft_limits,ft_abs,frameID,frameRPY,speed,FT_SEARCH_ACC,FT_SEARCH_ANG_SPD,FT_SEARCH_ANG_ACC,isSearchReturn,popupmsg)
  return retVal
  end 
  def ft_search_get_retract_pose(poseArray,actualStep,retract_m=-1,retract_rad=-1):
  local SafeIndex=actualStep+1
  if SafeIndex>=FT_SEARCH_HISTORY_LENGTH:
  SafeIndex=0
  end 
  local actualPose=poseArray[actualStep]
  local safePose=poseArray[SafeIndex]
  local directionPose=pose_trans(pose_inv(actualPose),safePose)
  local directionUnit=normalize([directionPose[0],directionPose[1],directionPose[2],directionPose[3],directionPose[4],directionPose[5]])
  local Pdist=pose_dist(actualPose,safePose)
  local retractVector=directionPose
  if(retract_m>=0):
  retractVector[0]=directionUnit[0]*retract_m
  retractVector[1]=directionUnit[1]*retract_m
  retractVector[2]=directionUnit[2]*retract_m
  end 
  if(retract_rad>=0):
  retractVector[3]=directionUnit[3]*retract_rad
  retractVector[4]=directionUnit[4]*retract_rad
  retractVector[5]=directionUnit[5]*retract_rad
  end 
  ft_search_safe_pose=pose_trans(actualPose,retractVector)
  return ft_search_safe_pose
  end 
  thread ft_search_safety_thread():
  ft_search_abscntr=0
  ft_search_history_cntr=0
  while True:
  enter_critical
  ft_search_abscntr=ft_search_abscntr+1
  ft_search_history_cntr=ft_search_history_cntr+1
  if ft_search_history_cntr>=FT_SEARCH_HISTORY_LENGTH:
  ft_search_history_cntr=0
  end 
  ft_search_history[ft_search_history_cntr]=get_actual_tcp_pose()
  exit_critical
  sync()
  end 
  end 
  ft_search_safety_thrd=run ft_search_safety_thread()
  def ft_search_retract(retractPose):
  if(on_speedl_integer_get()==0):
  movel(retractPose,a=FT_SEARCH_ACC,v=FT_SEARCH_RETRACT_SPD)
  else:
  cb_trajectory_move_absolute(retractPose,FT_SEARCH_RETRACT_SPD,FT_SEARCH_ACC,(FT_SEARCH_RETRACT_SPD*4.0),(FT_SEARCH_ACC*4.0),False)
  end 
  end 
  def ft_search_OK_retract(retractPose):
  if ft_search_return==0:
  ft_search_retract(retractPose)
  end 
  end 
  
