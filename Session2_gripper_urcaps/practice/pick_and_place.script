  def ft_limit_start(ft_select=ON_FALSE8D,ft_limits=ON_ZERO8D,ft_abs=ON_FALSE6D,v_min=0,frameID=0,frameRPY=ON_ZERO3D,popupmsg=True):
  local frame_rotvec=rpy2rotvec(frameRPY)
