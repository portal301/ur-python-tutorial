  def ft_trajectory_search_start(f3d=-1.0,t3d=-1.0):
  ft_select=ON_FALSE8D
  ft_limits=ON_ZERO8D
  ft_abs=ON_FALSE6D
  frameID=0
  frameRPY=ON_ZERO3D
  popupmsg=False
  speedLimit=0
  if(f3d>0):
  ft_select[6]=True
  ft_limits[6]=f3d
  end 
  if(t3d>0):
  ft_select[7]=True
  ft_limits[7]=t3d
  end 
  retVal=ft_limit_start(ft_select,ft_limits,ft_abs,speedLimit,frameID,frameRPY,popupmsg)
  cb_trajectory_return_validator(retVal,"F/T Limit: ")
  return retVal
  end 
  def ft_trajectory_limited(trajectoryID,ft_select=ON_FALSE8D,ft_limits=ON_ZERO8D,ft_abs=ON_FALSE6D,frameID=0,frameRPY=ON_ZERO3D,isSearchReturn=False,popupmsg=True):
