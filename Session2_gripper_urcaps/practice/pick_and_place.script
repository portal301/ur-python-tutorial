  def cb_trajectory_spiral(spiralStartEndPoses=[ON_ZEROPOSE,ON_ZEROPOSE],isRelative=True,speed=0.05,acc=1.2,angularSpeed=3.0,angularAcc=10.0,increase=0.001,direction=False,closingCircle=False,popupmsg=True):
  local retVal=0
  local isSearchReturn=False
  trajectoryID=cb_trajectory_spiral_init(spiralStartEndPoses,isRelative,speed,acc,angularSpeed,angularAcc,increase,direction,closingCircle)
  retVal=cb_trajectory(trajectoryID,isSearchReturn,popupmsg)
  return retVal
  end 
  def cb_trajectory_spiral_limited(spiralStartEndPoses=[ON_ZEROPOSE,ON_ZEROPOSE],ft_select=ON_FALSE8D,ft_limits=ON_ZERO8D,ft_abs=ON_FALSE6D,isRelative=True,speed=0.05,acc=1.2,angularSpeed=3.0,angularAcc=10.0,increase=0.01,direction=False,closingCircle=False,isSearchReturn=False,popupmsg=True):
  local retVal=0
  local frameRPY=ON_ZERO3D
  local frameID=1
  trajectoryID=cb_trajectory_spiral_init(spiralStartEndPoses,isRelative,speed,acc,angularSpeed,angularAcc,increase,direction,closingCircle)
  retVal=ft_trajectory_limited(trajectoryID,ft_select,ft_limits,ft_abs,frameID,frameRPY,isSearchReturn,popupmsg)
  return retVal
  end 
  
