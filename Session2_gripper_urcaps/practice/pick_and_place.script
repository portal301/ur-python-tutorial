  #======    OnRobot FT Zero    ======#
  
  def force_zero(zero=True):
  if ON_DEBUG_LOG:
  textmsg("FT Bias sending...")
  end 
  on_wait_ms(100)
  if(ft_gravity_compensation):
  on_xmlrpc.cb_robot_mount_gravity_compensation_stop()
  end 
  on_xmlrpc.ft_bias(zero)
  if(ft_gravity_compensation):
  sync()
  on_xmlrpc.cb_robot_mount_gravity_compensation(FT_GRAVITY)
  end 
  on_wait_ms(100)
  if ON_DEBUG_LOG:
  textmsg("FT Bias sent.")
  end 
  end 
  def ft_bias(zero=True):
  force_zero(zero)
  end 
  
  #======    End of OnRobot FT Zero    ======#
