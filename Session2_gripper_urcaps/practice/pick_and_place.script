  def rg2ft_dataRead():
  local reg_offset_bool=ON_DEVICE_SHIFT_BOOL_ARR[0]
  local reg_offset_int=ON_DEVICE_SHIFT_INT_ARR[0]
  local reg_offset_float=ON_DEVICE_SHIFT_FLOAT_ARR[0]
  enter_critical
  floatRegDummy=read_input_float_register(reg_offset_float+0)
  FT_Left[0]=floatRegDummy
  floatRegDummy=read_input_float_register(reg_offset_float+1)
  FT_Left[1]=floatRegDummy
  floatRegDummy=read_input_float_register(reg_offset_float+2)
  FT_Left[2]=floatRegDummy
  floatRegDummy=read_input_float_register(reg_offset_float+3)
  FT_Left[3]=floatRegDummy
  floatRegDummy=read_input_float_register(reg_offset_float+4)
  FT_Left[4]=floatRegDummy
  floatRegDummy=read_input_float_register(reg_offset_float+5)
  FT_Left[5]=floatRegDummy
