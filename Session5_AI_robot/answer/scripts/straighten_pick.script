  # ============================================================
  # Day5 3단계 로봇 쪽 프로그램: 삐뚤어진 물체를 집어서 똑바로 내려놓기
  # - Day1 lecture3(socket_set_position1)과 같은 방식: 로봇이 PC에 접속 → "req_data" → PC가 값을 보내 줌
  # - 이 파일만 따로 보내면 안 됨. PC 프로그램이
  #   [Day2 그리퍼 정의] + [설정값] + [이 파일] + end 로 묶어서 보냄
  # - 설정값(PC_IP, PORT, TCP_CAMERA, HOVER, GRASP_ABOVE, SPEED_V, SPEED_A,
  #   GRIP_OPEN, GRIP_CLOSE, GRIP_FORCE)은 PC 프로그램 1번 절에서 바꿈
  # ============================================================

  # 그리퍼를 width(mm)만큼 벌리거나 좁히기 (Day2와 같음)
  def grip(width):
    rg2ft_grip(width, GRIP_FORCE, tool_index=0, blocking=True, depth_comp=False, popupmsg=True)
  end

  # 직선 이동
  def go(pose):
    movel(pose, a=SPEED_A, v=SPEED_V)
  end

  # ------------------------------------------------------------
  # 1. PC에 접속해서 물체 정보 받기: (x, y, z, a)
  #    x, y, z = 카메라 기준 물체 위치(m), a = 손목을 돌릴 각도(rad)
  # ------------------------------------------------------------
  socket_open(PC_IP, PORT, "pc")
  socket_send_line("req_data", "pc")
  buf = socket_read_ascii_float(4, socket_name="pc", timeout=5)
  socket_close("pc")
  if buf[0] != 4:                                   # buf[0] = 받은 숫자 개수. 4개가 아니면 멈춤
    popup("PC data error", error=True)
    halt
  end
  obj_cam = p[buf[1], buf[2], buf[3], 0, 0, 0]
  a = buf[4]

  # ------------------------------------------------------------
  # 2. 카메라 기준 → 베이스 기준 (pose_trans: 앞 자세 기준으로 뒤 자세만큼 옮긴 자세)
  # ------------------------------------------------------------
  now = get_actual_tcp_pose()                       # 지금 툴(그리퍼 끝) 자세
  cam = pose_trans(now, TCP_CAMERA)                 # 지금 카메라 자세
  obj = pose_trans(cam, obj_cam)                    # 물체 위치 (베이스 기준)

  # ------------------------------------------------------------
  # 3. 집고 놓는 데 필요한 자세 4개
  # ------------------------------------------------------------
  hover = p[obj[0], obj[1], obj[2] + HOVER, now[3], now[4], now[5]]          # 물체 위, 손목은 지금 그대로
  down = p[obj[0], obj[1], obj[2] + GRASP_ABOVE, now[3], now[4], now[5]]     # 내려간 자리, 손목 그대로
  hover_rot = pose_trans(hover, p[0, 0, 0, 0, 0, a])                         # 물체 위, 손목을 a만큼 돌림
  down_rot = pose_trans(down, p[0, 0, 0, 0, 0, a])                           # 내려간 자리, 손목을 a만큼 돌림

  # ------------------------------------------------------------
  # 4. 집기 → 손목 되돌리기 → 놓기
  # ------------------------------------------------------------
  grip(GRIP_OPEN)       # 시작 전에 벌려 두기
  go(hover)             # 물체 위로
  go(hover_rot)         # 손목을 물체에 맞춰 돌림
  go(down_rot)          # 내려감
  grip(GRIP_CLOSE)      # 잡기
  go(hover_rot)         # 올라옴
  go(hover)             # 손목을 원래대로 → 물체가 똑바로 섬
  go(down)              # 내려감
  grip(GRIP_OPEN)       # 놓기
  go(hover)             # 올라옴
  go(now)               # 처음 자세로 돌아옴
